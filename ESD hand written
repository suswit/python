        AREA ADDITION, CODE, READONLY
        ENTRY
        EXPORT __main

__main

        MOV     r0, #10     ; Counter
        MOV     r1, #0      ; Sum
        MOV     r2, #1      ; Current number

NEXT
        ADD     r1, r1, r2  ; r1 = r1 + r2
        ADD     r2, r2, #1  ; r2 = r2 + 1
        SUBS    r0, r0, #1  ; decrement counter
        BNE     NEXT        ; repeat until r0 = 0

STOP
        NOP

        END

